{% for product in collection.products limit: 5 offset: 1 %}
    <p style="font-weight: bold;
            {% if forloop.first %}
                color: green
            {% elsif forloop.last %}
                color: red
            {% else %}
                color: orange
            {% endif %}
        ">
            {{ forloop.index }} - {{ product.title }}
        </p>
    {% if product.tags.size > 0 %}        
        <h3>Tags:</h3>
        {% for tag in product.tags %}
            <li>{{ tag }}</li>
        {% endfor %}
    {% endif %}
    
{% endfor %}